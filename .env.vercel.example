# ─────────────────────────────────────────────────────────────────────────────
# SimVault — Required Vercel Environment Variables
# Add each of these in your Vercel project:
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (from Neon, Supabase, Railway, etc.)
# Must be accessible from Vercel's serverless runtime.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Strong random secret used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# NODE_ENV is set to "production" automatically by Vercel — do not override it.
