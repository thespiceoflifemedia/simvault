# =============================================================================
# SimVault Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to Git — it is already listed in .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# Frontend / SimVault app (artifacts/gss-admin)
# ---------------------------------------------------------------------------

# Port for the Vite dev server (Replit sets this automatically)
# Defaults to 5173 if not set (standard Vite default)
PORT=5173

# Base path for the app (Replit sets this automatically)
# Use "/" for standalone Vercel/local deployments
BASE_PATH=/

# ---------------------------------------------------------------------------
# API Server (artifacts/api-server) — only needed if running the full stack
# ---------------------------------------------------------------------------

# Secret used to sign sessions. Generate with: openssl rand -base64 32
SESSION_SECRET=your-secret-here

# Database connection URL (if applicable)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - The SimVault frontend is a fully static React/Vite app.
# - PORT and BASE_PATH are only used by the Vite dev/preview server.
# - Neither variable is bundled into the production output.
# - For Vercel deployments, no environment variables are required.
